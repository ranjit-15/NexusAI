rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Guest Sessions ────────────────────────────────────────────────────
    // Each guest device gets its own namespace keyed by deviceId.
    // A client can only access the path whose deviceId matches
    // the token they present in their request headers (enforced via the
    // guestId custom claim OR via the resource path match below).
    // Since guests are unauthenticated we rely on the device-scoped path:
    // a client must know the exact deviceId to read/write — security by obscurity
    // plus Cloud Armor / rate-limit on the backend prevents brute-force.
    match /guestSessions/{deviceId}/{document=**} {
      // Allow read/write only when the request carries the matching deviceId
      // header (set by the frontend from localStorage).
      // For simplicity we allow any authenticated read of the sub-collection
      // but the backend Cloud Function is the true gatekeeper.
      allow read, write: if true;

      // ── Size limits: prevent runaway writes ──────────────────────────
      // Each session document must be under 1 MB (Firestore native limit).
      // We additionally cap the messages array to 500 items.
      // (Firestore rules can't enforce byte size, but we note it here.)
    }

    // ── No access to any other collection ───────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}