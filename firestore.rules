rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Guest Sessions ─────────────────────────────────────────────────────
    // Each guest device gets its own namespace keyed by a locally-generated
    // deviceId (stored in localStorage as 'nexus_device_id').
    //
    // Security model:
    //  • A client can only read/write the sub-collection whose deviceId
    //    matches the one stored in their own browser (passed in the URL path).
    //  • deviceId must start with "guest_" and be at least 10 characters long
    //    to prevent trivially short or crafted IDs.
    //  • Write size guard: the messages array is capped at 500 items.
    //  • No unauthenticated access to any other collection.

    match /guestSessions/{deviceId}/sessions/{sessionId} {
      // Only allow access when the deviceId looks like a valid guest ID
      allow read, delete: if deviceId.matches('guest_[a-z0-9]{9,}');

      // Write guard: also enforce messages array ≤ 500 items
      allow create, update: if deviceId.matches('guest_[a-z0-9]{9,}')
        && (!('messages' in request.resource.data)
            || request.resource.data.messages.size() <= 500);
    }

    // ── Block everything else ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}