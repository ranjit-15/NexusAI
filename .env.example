# ─────────────────────────────────────────────────────────────────
# NexusAI Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env or .env.local to git.
# ─────────────────────────────────────────────────────────────────

# ── Gemini AI (Required) ──────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server Port (Local Dev) ───────────────────────────────────────
PORT=8788

# ── Pico API Keys (Image Generation + LLM Fallback) ──────────────
# Get keys at: https://buildpicoapps.com
# Comma-separated list of keys for load balancing
PICO_IMAGE_KEYS=your_pico_key_1,your_pico_key_2,your_pico_key_3

# Single key for LLM fallback
PICO_LLM_KEY=your_pico_llm_key_here

# ── Firebase (Required for Firestore chat persistence) ────────────
# Get these from your Firebase project console → Project Settings → Your apps
# VITE_ prefix is required so Vite exposes them to the browser bundle.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
