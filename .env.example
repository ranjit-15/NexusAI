# ─────────────────────────────────────────────────────────────────
# NexusAI Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env or .env.local to git.
# ─────────────────────────────────────────────────────────────────

# ── Gemini AI (Required) ──────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server Port (Local Dev) ───────────────────────────────────────
PORT=8788

# ── Pico API Keys (Image Generation + LLM Fallback) ──────────────
# Get keys at: https://buildpicoapps.com
# Comma-separated list of keys for load balancing
PICO_IMAGE_KEYS=your_pico_key_1,your_pico_key_2,your_pico_key_3

# Single key for LLM fallback
PICO_LLM_KEY=your_pico_llm_key_here
