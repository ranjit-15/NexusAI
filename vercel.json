{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 60
    }
  },
  "env": {
    "GEMINI_API_KEY": "@gemini_api_key",
    "PICO_IMAGE_KEYS": "@pico_image_keys",
    "PICO_LLM_KEY": "@pico_llm_key"
  }
}
